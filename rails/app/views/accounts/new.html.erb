<% content_for :title, "Sign up" %>

<% unless hotwire_native_app? %>
  <h1 class="font-semibold text-4xl mb-6">
    Sign up
  </h1>
<% end %>

<%= form_with(model: user, url: account_path) do |f| %>
  <div>
    <%= f.label :username %>
    <%= f.text_field :username,
      required: true,
      autofocus: true,
      autocomplete: "username",
      placeholder: "Enter a username",
      class: "w-full block border-2 border-gray-300 rounded-lg px-2 py-1" %>
  </div>

  <div class="mt-3">
    <%= f.label :password %>
    <%= f.password_field :password,
      required: true,
      autocomplete: "new-password",
      placeholder: "Enter a password",
      class: "w-full block border-2 border-gray-300 rounded-lg px-2 py-1" %>
  </div>

  <%= f.submit "Sign up",
    class: "block cursor-pointer bg-teal-300 hover:bg-teal-400 rounded px-4 py-2 mt-3" %>
<% end %>

<p class="mt-4">
  Got an account? <%= link_to "Sign in instead", new_session_path, class: "text-teal-700 underline" %>
</p>
