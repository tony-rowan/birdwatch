<p style="color: green"><%= notice %></p>

<% content_for :title, "Posts" %>

<h1>Posts</h1>

<div id="posts">
  <%= render partial: "posts/post", collection: posts %>
</div>

<% if authenticated? %>
  <%= link_to "New post", new_post_path %>
<% else %>
  <p><%= link_to "Sign in", new_session_path %> or <%= link_to "Sign up", new_account_path %> to add your post.</p>
<% end %>
