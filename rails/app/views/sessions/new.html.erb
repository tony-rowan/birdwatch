<% content_for :title, "Sign in" %>

<% unless hotwire_native_app? %>
  <h1 class="font-semibold text-4xl mb-6">
    Sign in
  </h1>
<% end %>

<%= form_with url: session_path do |form| %>
  <div>
    <%= form.label :username %>
    <%= form.text_field :username,
      required: true,
      autofocus: true,
      autocomplete: "username",
      placeholder: "Enter your username",
      value: params[:username],
      class: "w-full block border-2 border-gray-300 rounded-lg px-2 py-1" %>
  </div>

  <div class="mt-3">
    <%= form.label :password %>
    <%= form.password_field :password,
      required: true,
      autocomplete:
      "current-password",
      placeholder: "Enter your password",
      class: "w-full block border-2 border-gray-300 rounded-lg px-2 py-1" %>
  </div>

  <%= form.submit "Sign in",
    class: "block cursor-pointer bg-teal-300 hover:bg-teal-400 rounded px-4 py-2 mt-3" %>
<% end %>

<p class="mt-4">
  No account? <%= link_to "Sign up instead", new_account_path, class: "text-teal-700 underline" %>
</p>
